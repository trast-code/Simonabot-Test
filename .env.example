# --- Required ---
# Your MongoDB connection string (stores WhatsApp session, XP, settings and daily AI usage totals)
MONGODB=mongodb+srv://user:password@cluster.example.mongodb.net/nezuko
# Bot owners: phone numbers with country code, digits only, comma separated
MODS=919876543210
PREFIX=!
# Unique random secret, at least 32 characters. Generate with: openssl rand -hex 32
SESSION_ID=

# QR endpoint security. HTTPS is required by default.
TRUST_PROXY_HOPS=0
QR_REQUIRE_HTTPS=true

# --- SimbaKI (OpenAI-compatible Chat Completions API) ---
# API key from your chosen AI provider. Without it, !ki stays disabled.
AI_API_KEY=
# Defaults to OpenAI. Change both URL and model for another compatible provider.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Linking ---
PAIRING_NUMBER=

# --- Optional API keys ---
GOOGLE_API=
GOOGLE_CX=
WEATHER_API=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube (youtubei.js) ---
YT_AUTO_PO_TOKEN=true
YT_COOKIE=
YT_PO_TOKEN=
YT_CLIENTS=
YT_DOWNLOADER=auto
YTDLP_PATH=
YTDLP_ARGS=
MAX_AUDIO_MINUTES=20
MAX_VIDEO_MINUTES=10
MAX_VIDEO_HEIGHT=720

# --- Misc ---
PORT=8080
LOG_LEVEL=silent
